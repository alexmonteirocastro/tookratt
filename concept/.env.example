# Browser-reachable API URL. Local Vite proxies /api → localhost:8000.
VITE_API_BASE_URL=/api

# Snapshot is the booth/production default (also the code default when this
# var is unset). Copy to gitignored .env.local and set false only when a
# VITE_DEMO_API_KEY is present and the API is running. Do not put this in
# .env.development — that file outranks .env.local in Vite.
# VITE_USE_SNAPSHOT=false

# Local live calls only. Never bake this into a production bundle — the same
# key also authorizes POST /chat.
# VITE_DEMO_API_KEY=
