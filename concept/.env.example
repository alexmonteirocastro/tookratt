# Browser-reachable API URL. Local Vite proxies /api → localhost:8000.
VITE_API_BASE_URL=/api

# Snapshot is the booth/production default. Set false locally only when a
# gitignored VITE_DEMO_API_KEY is present and the API is running.
VITE_USE_SNAPSHOT=true

# Local live calls only. Never bake this into a production bundle — the same
# key also authorizes POST /chat.
# VITE_DEMO_API_KEY=
