# Chat app URL shown in nav / CTAs (production default is app.tookratt.com).
# VITE_APP_URL=https://app.tookratt.com

# ALE-177 Worker endpoint (see workers/capture/). Leave unset to use mailto:hello@tookratt.com.
# VITE_CAPTURE_URL=https://capture.tookratt.com

# Public Turnstile site key (secret key belongs in the Worker only — never here).
# VITE_TURNSTILE_SITE_KEY=

# Build-time market snapshot only. Do not use a VITE_ prefix.
# Node does not load this file for prebuild; export it in the shell or set it on Pages.
# TOOKRATT_API_KEYS=
